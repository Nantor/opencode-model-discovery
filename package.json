{
  "name": "opencode-model-discovery",
  "version": "1.0.0",
  "description": "OpenCode plugin that discovers models from OpenAI-compatible LiteLlm providers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/opencode-model-discovery.js",
  "exports": {
    ".": {
      "import": "./dist/opencode-model-discovery.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/opencode-model-discovery.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest src",
    "test:run": "vitest run src",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode-ai/plugin": "^1.18.25",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.11"
  }
}
