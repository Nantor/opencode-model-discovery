{
  "name": "litellm-to-opencode",
  "version": "1.0.0",
  "description": "Fetch models from a LiteLLM API and map them into an OpenCode config",
  "type": "module",
  "bin": {
    "litellm-to-opencode": "./dist/index.js"
  },
  "scripts": {
