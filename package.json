{
  "name": "opencode-model-discovery",
  "version": "1.7.1",
  "description": "OpenCode plugin that discovers models from OpenAI-compatible LiteLlm providers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/opencode-model-discovery.js",
  "exports": {
    ".": {
      "import": "./dist/opencode-model-discovery.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rimraf dist && tsc --noEmit && node scripts/build.mjs",
    "build:fallback": "rimraf dist && tsc --noEmit && node scripts/build.mjs --variant=fallback",
    "build:slim": "rimraf dist && tsc --noEmit && node scripts/build.mjs --variant=slim",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest src scripts",
    "test:run": "vitest run src scripts",
    "test:host": "npm run build && node scripts/host-smoke.mjs",
    "debug:provider": "node scripts/debug-provider.ts",
    "deploy:local": "node scripts/deploy-local.mjs",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/plugin": "^2.2.3",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@opencode-ai/models": "^0.0.120"
  }
}
